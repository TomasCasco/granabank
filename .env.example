# Neon: connection string WITH pooling (host contains "-pooler"). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Neon: connection string WITHOUT pooling. Used by Prisma migrations and the seed.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Random secret to sign session tokens. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me"
